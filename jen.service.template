[Unit]
Description=Jen - Kea DHCP Management Console
After=network.target

[Service]
Type=simple
User=www-data
# v5.14.0 — the versioned layout. `@@APP_DIR@@/current` is a symlink to the
# live release directory (`releases/<X.Y.Z>/`), flipped atomically by
# install.sh and the root self-updater. The unit points at that stable
# path; a rollback is one symlink flip + `systemctl restart jen`.
WorkingDirectory=@@APP_DIR@@/current/app
# The per-release venv interpreter runs run.py directly — run.py's own
# re-exec shim then sees it is already the venv python and stays put. On
# a still-flat box (the transition install of 5.14.0, or Docker) this
# path won't exist yet; the shim falls back to the flat venv or the
# system interpreter, and the migration run / `install.sh --upgrade`
# creates `current`.
ExecStart=@@APP_DIR@@/current/venv/bin/python @@APP_DIR@@/current/app/run.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
# v5.68.0-beta.15 (Q150) - everything the service creates is private to it by default: jen.config, the SSL key and the Fernet key
# are also written 0600-from-the-first-byte by jen/services/private_files.py, and run.py sets the same umask for Docker. The root
# self-updater and the plugin installer are separate units (their own umask) and are not affected.
UMask=0077
# v5.67.0 (Q114) — this unit is rendered, not copied, from
# jen.service.template: @@APP_DIR@@/@@CONFIG_DIR@@/@@DATA_DIR@@ are filled
# in from /etc/jen-layout.conf (absent = the historical defaults
# /opt/jen, /etc/jen, /var/lib/jen — see docs/ARCHITECTURE.md §6.1). These
# three Environment= lines are what let jen/extensions.py's existing
# JEN_ROOT / JEN_CONFIG_DIR / JEN_CONTENT_DIR overrides resolve every
# app-side path without any layout-specific code in the app itself.
Environment=JEN_ROOT=@@APP_DIR@@/current/app
Environment=JEN_CONFIG_DIR=@@CONFIG_DIR@@
Environment=JEN_CONTENT_DIR=@@DATA_DIR@@
# v5.67.0-beta.6 (Q118) — the explicit signal jen.services.runtime.deployment()
# looks for first to tell a real systemd host apart from Docker/dev, now that
# JEN_ROOT above is set here too and can no longer be used for that (systemd's
# own INVOCATION_ID is deployment()'s fallback, covering a unit rendered
# before this release or a hand-written one — this line exists for clarity
# and so neither has to be relied on alone).
Environment=JEN_SERVICE_MANAGER=systemd

# v5.5.0 — run.py launches gunicorn (directly via exec when there's no
# SSL, or as a child alongside the HTTP->HTTPS redirect when there is).
# Give gunicorn's graceful shutdown (--graceful-timeout 30) room to
# finish before systemd escalates to SIGKILL, and send the stop signal
# to the whole process group so the redirect child goes too.
KillMode=mixed
TimeoutStopSec=40

# v5.17.0 (Q6 6E) — sandboxing. NOT NoNewPrivileges / CapabilityBoundingSet
# / ProtectProc: Jen shells out to `sudo` for the self-updater and (on the
# legacy path) the Kea hosts, which needs the setuid transition. The root
# self-updater is its own unit (jen-update.service) and is deliberately
# left un-sandboxed — do not copy these lines there.
ProtectSystem=strict
ReadWritePaths=@@CONFIG_DIR@@ @@DATA_DIR@@
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
PrivateDevices=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
