# Jen - The Internet Management Console
# Version 3.8.0 Configuration File
#
# Copy this file to /etc/jen/jen.config and fill in your values.
# This file is gitignored — never commit jen.config with real credentials.

[kea]
# How Jen reaches Kea's command API. Default 'ca' — unchanged from every
# release before 5.10.0 — and 'direct'.
#   ca     : api_url is a kea-ctrl-agent that routes commands to
#            kea-dhcp4 / kea-dhcp6 by the "service" field.
#   direct : api_url is kea-dhcp4's OWN http control socket. Use this on
#            Kea 3.2+, which removed the Control Agent (it was deprecated
#            in 3.0). Set [kea6] api_url to kea-dhcp6's socket if you run
#            IPv6. Add an http entry to control-sockets in each daemon's
#            config (see docs/admin-guide.md "Kea → Direct control sockets").
# In direct mode api_url MUST include an explicit port (a daemon control
# socket is never on 80/443).
# connection_mode = ca
api_url  = http://YOUR-KEA-SERVER:8000
api_user = kea-api
api_pass = your-kea-api-password
# Optional, only for an https:// api_url (a TLS control socket):
#   api_ca         — path on the Jen host to the CA bundle that signed the
#                    Kea socket's cert. Pins verification to that CA.
#   api_tls_verify — set false to skip verification entirely (default true).
#   api_client_cert / api_client_key (5.10.2) — a client-cert PEM + key on
#                    the Jen host. Kea's per-daemon https socket defaults
#                    cert-required=true (mutual TLS), so without these an
#                    https:// endpoint refuses the handshake. Set both or
#                    neither; the key must be readable by www-data
#                    (root:www-data 640 under /etc/jen/ssl/).
# api_ca = /etc/jen/ssl/kea-ca.pem
# api_tls_verify = true
# api_client_cert = /etc/jen/ssl/jen-kea-client.pem
# api_client_key  = /etc/jen/ssl/jen-kea-client.key
# Friendly name shown in the UI and alerts
name     = Kea Server 1
# Role: primary or standby
role     = primary
# HA mode — leave blank for standalone, or set to:
#   hot-standby      — primary active, standby takes over on failure
#   load-balancing   — both nodes share the load
#   passive-backup   — primary active, backup receives updates only
# Must match ha-mode in kea-dhcp4.conf on your Kea servers
ha_mode  =

[kea_db]
# Kea MySQL database
host     = YOUR-KEA-SERVER
user     = kea
password = your-kea-db-password
database = kea
# ssl_ca = /etc/jen/ssl/mariadb-ca.pem   # optional, v4.4.5+ — enables TLS
#   for this connection and verifies the server cert against this CA.
#   Leave commented/blank for plaintext (unchanged default). Needed if
#   your MariaDB is on a different host than Jen and you want the DB
#   traffic (leases, MACs, hostnames) encrypted on the wire.

[jen_db]
# Jen MySQL database (separate from Kea)
host     = YOUR-DB-SERVER
user     = jen
password = your-jen-db-password
database = jen
# ssl_ca = /etc/jen/ssl/mariadb-ca.pem   # optional, v4.4.5+ — see kea_db above.
#   Set independently since jen_db and kea_db can be different hosts/certs.

[server]
http_port  = 5050
https_port = 8443

# Optional: running Jen behind a reverse proxy (nginx, Caddy, Traefik, …).
# Comma-separated list of proxy IPs or CIDRs Jen should trust. When the
# request comes from one of these, Jen reads the real client IP from
# X-Forwarded-For and the scheme from X-Forwarded-Proto (so rate limiting,
# the audit log and MFA device records see the real client, and the Secure
# cookie flag + HSTS turn on). The proxy MUST terminate HTTPS. Leave unset
# if Jen is reached directly.
# trusted_proxies = 127.0.0.1, 10.0.0.0/8

# Optional: protect the /metrics (Prometheus) endpoint with a Bearer token.
# If set, scraper must send: Authorization: Bearer <your-token>
# Leave commented to allow unauthenticated access (e.g. if restricted at proxy level).
# metrics_token = your-secret-scrape-token

# Optional: logging configuration (v4.4.15+).
# log_level defaults to INFO. log_format defaults to "plain" (human-readable,
# safe for `journalctl -u jen -f`) — set to "json" for one JSON object per
# line, useful for Loki/ELK/Promtail without a log-parsing regex.
# log_file is optional; if unset, Jen logs to stdout/stderr only, which
# systemd's journal already captures and rotates via journald.conf. Set
# log_file if you want to tail a real file directly instead (e.g. shipping
# via Promtail without journal export tooling) — log_retention_days
# controls how many daily rotated files are kept (default 14).
# log_level = INFO
# log_format = plain
# log_file = /var/log/jen/jen.log
# log_retention_days = 14

[kea_ssh]
# SSH connection to Kea server for subnet editing
# Leave host blank to disable subnet editing
host     = YOUR-KEA-SERVER
user     = your-ssh-user
key_path = /etc/jen/ssh/jen_rsa
kea_conf = /etc/kea/kea-dhcp4.conf

# For HA setups, add additional servers:
# [kea_server_2]
# name     = Kea Standby
# role     = standby
# api_url  = http://YOUR-STANDBY-SERVER:8000
# api_user = kea-api
# api_pass = your-kea-api-password
# ssh_host = YOUR-STANDBY-SERVER
# ssh_user = your-ssh-user
# kea_conf = /etc/kea/kea-dhcp4.conf
# Optional per-server DHCPv6 endpoint (direct mode) — api6_user/api6_pass
# fall back to api_user/api_pass:
# api6_url  = http://YOUR-STANDBY-SERVER:8006
# api6_user = kea-api
# api6_pass = your-kea-api-password

[subnets]
# Format: subnet_id = Friendly Name, CIDR
# Example:
# 1  = Production, 192.168.1.0/24
# 30 = IoT, 192.168.30.0/24
# 70 = VLAN70, 192.168.70.0/24

# ── IPv6 (v5.0, optional) ─────────────────────────────────────────────────
# Everything below is opt-in and only ever read once "Enable IPv6 support"
# is turned on in Settings -> Infrastructure (off by default on every
# install, new and existing). A v4-only install can leave all of this
# commented out and nothing changes — no new required config, no new
# required services.
#
# Both [kea6] and [kea6_db] are entirely optional.
#   ca mode     — api_url falls back to [kea] api_url (one Control Agent
#                 proxies both families — the common case). Only set it if
#                 kea-dhcp6 uses a separate CA/port.
#   direct mode — api_url is kea-dhcp6's OWN http control socket and there
#                 is NO fallback (a v4 daemon can't answer v6 commands).
#                 REQUIRED here if you run IPv6 in direct mode. ISC's
#                 example uses port 8004 for dhcp4; use 8006 for dhcp6.
# api_user / api_pass still fall back to [kea] in both modes.
# [kea6] applies to the PRIMARY server only — each [kea_server_N] sets its
# own api6_url / api6_user / api6_pass, and falls back to that server's own
# api_url / api_user / api_pass (ca mode), never to the primary's.
# [kea6_db] always falls back to [kea_db].

# [kea6]
# api_url  = http://YOUR-KEA-SERVER:8006
# api_user = kea-api
# api_pass = your-kea-api-password

# [kea6_db]
# host     = YOUR-KEA-SERVER
# user     = kea
# password = your-kea-db-password
# database = kea
# ssl_ca   = /etc/jen/ssl/mariadb-ca.pem

# [subnets6]
# Format: subnet_id = Friendly Name, CIDR[, paired_v4_subnet_id]   (Kea's
# own v6 subnet IDs — a separate numbering space from the v4 [subnets]
# section above; the same integer can validly appear in both sections and
# refer to different subnets). The optional third field pairs a v6 subnet
# with its v4 counterpart's [subnets] id so the Subnets page renders them
# as one card with two detail blocks; leave it off for an unpaired v6
# subnet, which just renders as its own card.
# 1 = Production, 2001:db8:1::/64, 1

[ddns]
# Kea DDNS log file path on the Kea server (read via SSH)
log_path     = /var/log/kea/kea-ddns.log

# DNS provider for hostname lookup on the DDNS page:
#   technitium  — Technitium DNS Server REST API
#   pihole      — Pi-hole REST API (v5 and v6 supported)
#   adguard     — AdGuard Home REST API
#   ssh         — DNS lookup via dig over SSH to Kea server (Bind9, Unbound, etc.)
#   none        — log viewer only, no hostname lookup
dns_provider = technitium

# Technitium DNS (dns_provider = technitium)
api_url      = https://your-technitium-server/api
api_token    = your-technitium-api-token
forward_zone = your.domain.com

# Pi-hole (dns_provider = pihole)
# api_url   = http://pi.hole
# api_token = your-pihole-password-or-api-token

# AdGuard Home (dns_provider = adguard)
# api_url   = http://adguard.local:3000
# api_user  = admin
# api_token = your-adguard-password

# SSH / Bind9 / Unbound (dns_provider = ssh)
# No additional config needed — uses the SSH connection from [kea_ssh]
