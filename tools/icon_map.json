  "rules": [
    {"emoji": "📋", "after": "(?i)^\\s*(copy)", "name": "copy"},
    {"emoji": "📋", "after": "(?i)^\\s*(leases?\\b|show active|ipv6 leases)", "name": "list"},
    {"emoji": "📋", "after": "(?i)^\\s*(changelog|release notes|full changelog)", "name": "file-text"},
    {"emoji": "📋", "file": "leases\\.html", "name": "list"},
    {"emoji": "📱", "after": "(?i)(devices|device inventory|top active)", "name": "monitor-smartphone"},
    {"emoji": "📱", "file": "nav\\.py", "name": "monitor-smartphone"},
    {"emoji": "🔑", "after": "(?i)(passkey)", "name": "fingerprint-pattern"},
    {"emoji": "📊", "after": "(?i)^\\s*(dashboard)", "name": "layout-dashboard"},
    {"emoji": "📊", "after": "^\\s*\\{\\{ h\\.name", "name": "chart-bar"},
    {"emoji": "📈", "after": "(?i)^\\s*reports", "name": "chart-line"},
    {"emoji": "🌐", "after": "(?i)^\\s*(subnets|configured subnets)", "name": "network"},
    {"emoji": "🖥", "after": "(?i)^\\s*(kea servers|server status|servers|system)", "name": "server"},
    {"emoji": "⬇", "after": "(?i)(download|export|install)", "name": "download"},
    {"emoji": "⬆", "after": "(?i)(upload|import|update)", "name": "upload"},
    {"emoji": "⬆", "before": "\\}\\}\\s*$", "name": "arrow-up"},
    {"emoji": "📤", "after": "(?i)^\\s*export", "name": "download"},
    {"emoji": "📜", "after": "(?i)(trace|what kea logged)", "name": "search-code"},
