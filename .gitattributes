# v5.8.4 — keep the retired pre-2.6.0 monolith out of the release tarball.
# It's kept in the repo for reference only (see its header and ruff.toml's
# exclude); nothing imports or runs it, and it was shipping in every
# jen-vX.Y.Z.tar.gz built by `git archive` in release.yml.
legacy/ export-ignore
.gitattributes export-ignore

# v5.11.0 — jen-kea-helper is a shebang script run as root on Kea hosts.
# A CRLF from a misconfigured Windows checkout would break its `#!` line
# (`env: 'python3\r'`). Pin LF regardless of core.autocrlf.
jen-kea-helper text eol=lf
jen-update-root.py text eol=lf
run.py text eol=lf

# v5.17.0 — systemd rejects a unit file with CRLF line endings.
jen.service text eol=lf
jen-update.service text eol=lf
