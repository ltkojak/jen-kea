[Unit]
Description=Jen - Kea DHCP Management Console
After=network.target

[Service]
Type=simple
User=www-data
# v5.14.0 — the versioned layout. `/opt/jen/current` is a symlink to the
# live release directory (`releases/<X.Y.Z>/`), flipped atomically by
# install.sh and the root self-updater. The unit points at that stable
# path; a rollback is one symlink flip + `systemctl restart jen`.
WorkingDirectory=/opt/jen/current/app
# The per-release venv interpreter runs run.py directly — run.py's own
# re-exec shim then sees it is already the venv python and stays put. On
# a still-flat box (the transition install of 5.14.0, or Docker) this
# path won't exist yet; the shim falls back to /opt/jen/venv or the
# system interpreter, and the migration run / `install.sh --upgrade`
# creates `current`.
ExecStart=/opt/jen/current/venv/bin/python /opt/jen/current/app/run.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

# v5.5.0 — run.py launches gunicorn (directly via exec when there's no
# SSL, or as a child alongside the HTTP->HTTPS redirect when there is).
# Give gunicorn's graceful shutdown (--graceful-timeout 30) room to
# finish before systemd escalates to SIGKILL, and send the stop signal
# to the whole process group so the redirect child goes too.
KillMode=mixed
TimeoutStopSec=40

# v5.17.0 (Q6 6E) — sandboxing. NOT NoNewPrivileges / CapabilityBoundingSet
# / ProtectProc: Jen shells out to `sudo` for the self-updater and (on the
# legacy path) the Kea hosts, which needs the setuid transition. The root
# self-updater is its own unit (jen-update.service) and is deliberately
# left un-sandboxed — do not copy these lines there.
ProtectSystem=strict
ReadWritePaths=/etc/jen /var/lib/jen
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
PrivateDevices=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
