{
 "about": "The logger transformation of investigation logging's restore. Each case: restore `before` using `restore`, get `after`. `both` cases are run through jen.services.kea_config_edit.clear_investigation_logging (the marker's own restore object) AND jen-kea-helper's _restore_logger; the others only through the helper (it restores from its state file and needs no marker). Q165.",
 "cases": [
  {
   "name": "an entry Jen created is removed again",
   "both": true,
   "note": "",
   "before": {
    "Dhcp4": {
     "valid-lifetime": 3600,
     "subnet4": [],
     "loggers": [
      {
       "name": "kea-dhcp4",
       "severity": "DEBUG",
       "debuglevel": 55,
       "user-context": {
        "jen-investigation": {
         "until": "2099-01-01T00:00:00+00:00",
         "restore": {
          "created": true
         }
        }
       }
      }
     ]
    }
   },
   "restore": {
    "created": true
   },
   "after": {
    "Dhcp4": {
     "valid-lifetime": 3600,
     "subnet4": [],
     "loggers": []
    }
   }
  },
  {
   "name": "an existing entry gets its severity and debuglevel back and keeps its output options",
   "both": true,
   "note": "",
   "before": {
    "Dhcp4": {
     "valid-lifetime": 3600,
     "subnet4": [],
     "loggers": [
      {
       "name": "kea-dhcp4",
       "output-options": [
        {
         "output": "/var/log/kea/kea-dhcp4.log",
         "maxsize": 2048000,
         "maxver": 4,
         "flush": true
        }
       ],
       "severity": "DEBUG",
       "debuglevel": 55,
       "user-context": {
        "jen-investigation": {
         "until": "2099-01-01T00:00:00+00:00",
         "restore": {
          "severity": "WARN",
          "debuglevel": 0
         }
        }
       }
      },
      {
       "name": "kea-dhcp4.hosts",
       "severity": "INFO"
      }
     ]
    }
   },
   "restore": {
    "severity": "WARN",
    "debuglevel": 0
   },
   "after": {
    "Dhcp4": {
     "valid-lifetime": 3600,
