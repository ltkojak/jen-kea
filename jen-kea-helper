    "OnBootSec=30s\n"
    "OnUnitActiveSec=60s\n"
    "Persistent=true\n"
    "\n"
    "[Install]\n"
    "WantedBy=timers.target\n"
)
_SIGHUP = getattr(signal, "SIGHUP", 1)  # (1 on every POSIX host; the name does not exist on the Windows dev box that imports this file for its tests)
_INV_LOGGER = "kea-dhcp4"
_INV_KEY = "jen-investigation"


def _now():  # a name the tests replace
    return datetime.now(timezone.utc)


def _sleep(seconds):  # a name the tests replace
    time.sleep(seconds)


_monotonic = time.monotonic  # a name the tests replace (with `_sleep` advancing it): every wait below is wall-clock bounded, not a count of sleeps


def _parse_iso(text):
    """An aware UTC datetime from an ISO-8601 string, or None. A naive time is read as UTC."""
    if not isinstance(text, str):
        return None
    try:
        when = datetime.fromisoformat(text.strip().replace("Z", "+00:00"))
    except ValueError:
        return None
    return when if when.tzinfo else when.replace(tzinfo=timezone.utc)


def _restore_shape_ok(restore):
    """True iff `restore` is exactly `{"created": true}` or exactly `{"severity": ..., "debuglevel": ...}`, each either the literal "absent" or a real
    value (a non-empty string severity, an integer debuglevel). The same rule as `kea_config_edit.restore_problem`, stricter on extra keys."""
    if not isinstance(restore, dict):
        return False
    if set(restore) == {"created"}:
        return restore["created"] is True
    if set(restore) != {"severity", "debuglevel"}:
        return False
    severity, level = restore["severity"], restore["debuglevel"]
    if not (severity == "absent" or (isinstance(severity, str) and severity.strip())):
        return False
    return level == "absent" or (isinstance(level, int) and not isinstance(level, bool))


def _restore_logger(cfg, restore):
    """Put the `kea-dhcp4` logger of `cfg` back from `restore` - `{"created": true}` (remove the entry) or `{"severity", "debuglevel"}` (each restored, or removed when
    "absent") - and delete the `jen-investigation` marker. A port of `kea_config_edit.clear_investigation_logging`, kept identical by the shared vector file
    `tests/vectors/investigation_restore.json`. Unlike that function it does not need the marker: the logger is put back when it carries the marker OR still sits at
    DEBUG 55 (a person deleted only the marker); a logger that has neither was changed on purpose since and is left alone. Returns (new_cfg, "ok" | "nothing")."""
    cfg = copy.deepcopy(cfg)
    section = cfg.get("Dhcp4") if isinstance(cfg, dict) else None
    loggers = section.get("loggers") if isinstance(section, dict) else None
    if not isinstance(loggers, list):
        return cfg, "nothing"
    entry = next((x for x in loggers if isinstance(x, dict) and x.get("name") == _INV_LOGGER), None)
    if entry is None:
        return cfg, "nothing"
    context = entry.get("user-context")
    has_marker = isinstance(context, dict) and _INV_KEY in context
    at_level = str(entry.get("severity") or "").upper() == "DEBUG" and entry.get("debuglevel") == 55
    if not has_marker and not at_level:
        return cfg, "nothing"
    if restore.get("created"):
        loggers.remove(entry)
        return cfg, "ok"
    for key in ("severity", "debuglevel"):
        old = restore[key]
        if old == "absent":
            entry.pop(key, None)
        else:
            entry[key] = old
    if has_marker:
        del context[_INV_KEY]
        if not context:
            del entry["user-context"]
    return cfg, "ok"


def _root_ids():
    """(uid, gid) to give a file this helper creates for the system: root:root when it runs as root; (None, None) - leave it - for a test run by an ordinary user."""
    return (0, 0) if hasattr(os, "geteuid") and os.geteuid() == 0 else (None, None)


def _state_path(service):
    return os.path.join(_STATE_DIR, f"investigation-{service}.json")


def _ensure_state_dir():
    os.makedirs(_STATE_DIR, mode=0o700, exist_ok=True)
    if os.path.islink(_STATE_DIR):
        raise OSError(errno.ELOOP, "the state directory is a symlink", _STATE_DIR)
    uid, gid = _root_ids()
    if uid is not None:
        os.chown(_STATE_DIR, uid, gid)
    os.chmod(_STATE_DIR, 0o700)


def _read_state(service):
    """("absent", None) - no file; ("ok", state) - a usable state file; ("bad", detail) - a file that exists and cannot be trusted (unreadable, not JSON, not an object, not a shape
    `investigation-arm` writes). FOUR callers (arm, disarm, status, --self-restore), ONE answer: an existing file is never "no session"."""
    path = _state_path(service)
    if not os.path.lexists(path):
        return "absent", None
    try:
        with open(path, "rb") as f:
            state = json.loads(f.read().decode("utf-8"))
    except OSError as e:
        return "bad", f"unreadable: {e.strerror or e}"
    except ValueError as e:
        return "bad", f"not JSON: {e}"
    if not _state_usable(state):
        return "bad", "not a state this helper writes"
    return "ok", state


def _bad_state_sentence(detail):
    return (
        f"the host's investigation state file exists and cannot be trusted ({detail}); nothing is known about the session it records - look at {_state_path('dhcp4')}, "
        "then remove it or run `jen-kea-helper --self-restore --now`"
    )


def _save_state(service, state):
    uid, gid = _root_ids()
    _install_private(_state_path(service), json.dumps(state, indent=2).encode("utf-8"), uid, gid, 0o600)


def _state_usable(state):
    """A state file is acted on only if every field the restore uses is still what `investigation-arm` could have written."""
    return (
        isinstance(state, dict)
        and state.get("service") == "dhcp4"
        and _allowed_conf_path(state.get("path"))
        and _restore_shape_ok(state.get("restore"))
        and all(isinstance(state.get(k, 0), int) and not isinstance(state.get(k, 0), bool) for k in ("restarts", "attempts"))
    )


def _ensure_timer():
    """(timer, detail): install the timer units (written only when they differ) and start the timer. "systemd" when `systemctl` accepted it and reports it active; "none"
    - with the reason - on a host that has no systemd (a container) or that refuses. Jen turns logging on only for "systemd"."""
    if _find_bin("systemctl") is None:
        return "none", "systemctl not found under _BIN_DIRS"
    uid, gid = _root_ids()
    changed = False
    try:
        for name, text in ((f"{_TIMER_NAME}.service", _TIMER_SERVICE_TEXT), (f"{_TIMER_NAME}.timer", _TIMER_TEXT)):
            unit_path = os.path.join(_SYSTEMD_DIR, name)
            try:
                with open(unit_path, "rb") as f:
                    current = f.read()
            except FileNotFoundError:
                current = None
            if current != text.encode("utf-8"):
                os.makedirs(_SYSTEMD_DIR, exist_ok=True)
                _install_private(unit_path, text.encode("utf-8"), uid, gid, 0o644)
                changed = True
    except OSError as e:
        return "none", f"the timer units could not be written: {e}"
    if changed:
        proc = _run_bin("systemctl", ["daemon-reload"], capture_output=True, text=True)
        if proc is None or proc.returncode != 0:
            return "none", "systemctl daemon-reload failed"
    proc = _run_bin("systemctl", ["enable", "--now", f"{_TIMER_NAME}.timer"], capture_output=True, text=True)
    if proc is None or proc.returncode != 0:
        return "none", "systemctl could not enable the timer: " + "\n".join(((proc.stderr if proc else "") or "").splitlines()[-2:])
    proc = _run_bin("systemctl", ["is-active", f"{_TIMER_NAME}.timer"], capture_output=True, text=True)
    if proc is None or proc.stdout.strip() != "active":
        return "none", "the timer did not become active"
    return "systemd", ""


def _unit_main_pid(unit):
    proc = _run_bin("systemctl", ["show", "-p", "MainPID", "--value", unit], capture_output=True, text=True)
    text = (proc.stdout or "").strip() if proc else ""
    return int(text) if text.isdigit() else 0


def _find_id(lines, ids):
    for line in lines:
        for ident in ids:
            if re.search(r"\b" + re.escape(ident) + r"\b", line):
                return line.strip()
    return None


def _logger_entry(config):
    """The `kea-dhcp4` logger of `config`, or None when the file has none."""
    section = config.get("Dhcp4") if isinstance(config, dict) else None
    loggers = section.get("loggers") if isinstance(section, dict) else None
    if not isinstance(loggers, list):
        return None
    return next((x for x in loggers if isinstance(x, dict) and x.get("name") == _INV_LOGGER), None)


def _file_log_path(config):
    """The first file output of the kea-dhcp4 logger under /var/log, else None (a daemon that logs to syslog or stdout has no log file to read)."""
    entry = _logger_entry(config) or {}
    for option in entry.get("output-options") or []:
        out = option.get("output") if isinstance(option, dict) else None
        if _allowed_log_path(out):
            return out
    return None


_LOCAL_ADDRESSES = {"127.0.0.1": "127.0.0.1", "localhost": "127.0.0.1", "::1": "::1", "0.0.0.0": "127.0.0.1", "::": "::1"}  # nosec B104 - read, never bound


def _http_credentials(entry):
    """(user, password) of the first basic-auth client of an http control socket entry, inline (`user`/`password`) or in files (`user-file`/`password-file` under `directory`, default /etc/kea)."""
    auth = entry.get("authentication")
    if not isinstance(auth, dict) or str(auth.get("type") or "").lower() != "basic":
        return None
    directory = auth.get("directory") if isinstance(auth.get("directory"), str) else "/etc/kea"
    for client in auth.get("clients") or []:
        if not isinstance(client, dict):
            continue
        if isinstance(client.get("user"), str) and isinstance(client.get("password"), str):
            return client["user"], client["password"]
        if isinstance(client.get("user-file"), str) and isinstance(client.get("password-file"), str):
            try:
                with open(os.path.join(directory, client["user-file"]), encoding="utf-8") as f:
                    user = f.read().strip()
                with open(os.path.join(directory, client["password-file"]), encoding="utf-8") as f:
                    password = f.read().strip()
            except OSError:
                continue
            if user:
                return user, password
    return None


def _control_socket(config):
    """The dhcp4 daemon's own control socket from its config: ("unix", path) for a unix socket (preferred), ("http", (address, port, user, password)) for a PLAIN http socket bound to
    a local address with basic auth whose credentials are inline or in files - the two shapes Jen authors - else None (https, a remote address, no auth: no socket evidence; the log
    and the process remain). `control-socket` (singular, pre-2.7.2) is read as a one-entry list. 0.0.0.0 and :: are asked at 127.0.0.1 / ::1."""
    section = config.get("Dhcp4") if isinstance(config, dict) else None
    if not isinstance(section, dict):
        return None
    entries = section.get("control-sockets")
    if entries is None and isinstance(section.get("control-socket"), dict):
        entries = [section["control-socket"]]
    if not isinstance(entries, list):
        return None
    entries = [e for e in entries if isinstance(e, dict)]
    for entry in entries:
        name = entry.get("socket-name")
        if str(entry.get("socket-type") or "").lower() == "unix" and isinstance(name, str) and name.startswith("/"):
            return "unix", name
    for entry in entries:
        if str(entry.get("socket-type") or "").lower() != "http":
            continue
        if any(k in entry for k in ("trust-anchor", "cert-file", "key-file", "cert-required")):
            continue  # https: the helper does not speak TLS to the daemon
        address = _LOCAL_ADDRESSES.get(str(entry.get("socket-address") or "127.0.0.1").lower())
        port = entry.get("socket-port", 8000)
        credentials = _http_credentials(entry)
        if address and isinstance(port, int) and not isinstance(port, bool) and 0 < port < 65536 and credentials:
            return "http", (address, port, credentials[0], credentials[1])
    return None


def _ask_daemon(sock_spec, command):
    """One command to the daemon's own control socket -> the reply dict, or None (no socket, refused, timeout, not JSON, not an object). Never raises. The reply is read until it parses as
    JSON (Kea may keep the connection open), bounded by `_SOCKET_WAIT_S` and `_SOCKET_READ_MAX`; a list reply (the Control Agent's wrapping) is unwrapped."""
    kind, where = sock_spec
    body = json.dumps({"command": command}).encode("utf-8")
    s = None
    try:
        if kind == "unix":
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.settimeout(_SOCKET_WAIT_S)
            s.connect(where)
            s.sendall(body)
        else:
            address, port, user, password = where
            s = socket.create_connection((address, port), timeout=_SOCKET_WAIT_S)
            token = base64.b64encode(f"{user}:{password}".encode("utf-8")).decode("ascii")
            head = (
                f"POST / HTTP/1.0\r\nHost: {address}\r\nContent-Type: application/json\r\nAuthorization: Basic {token}\r\nContent-Length: {len(body)}\r\n\r\n"
            )
            s.sendall(head.encode("ascii") + body)
        buf, deadline = b"", time.monotonic() + _SOCKET_WAIT_S
        while time.monotonic() < deadline and len(buf) < _SOCKET_READ_MAX:
            try:
                chunk = s.recv(65536)
            except socket.timeout:
                break
            if not chunk:
                break
            buf += chunk
            if kind == "http" and b"\r\n\r\n" not in buf:
                continue
            text = buf.partition(b"\r\n\r\n")[2] if kind == "http" else buf
            try:
                reply = json.loads(text.decode("utf-8"))
            except ValueError:
                continue
            if isinstance(reply, list) and reply:
                reply = reply[0]
            return reply if isinstance(reply, dict) else None
        if kind == "http" and b"\r\n\r\n" in buf:  # the daemon closed after its reply: whatever it sent is the whole body
            try:
                reply = json.loads(buf.partition(b"\r\n\r\n")[2].decode("utf-8"))
            except ValueError:
                return None
            if isinstance(reply, list) and reply:
                reply = reply[0]
            return reply if isinstance(reply, dict) else None
        return None
    except (OSError, ValueError):
        return None
    finally:
        if s is not None:
            with contextlib.suppress(OSError):
                s.close()


def _daemon_logger_now(sock_spec):
    """What the RUNNING kea-dhcp4 says its logger is: {"present", "severity", "debuglevel", "marker"} - the port of Jen's `daemon_logger` - or None when it could not be asked.
    None is "could not see", never "restored"."""
    reply = _ask_daemon(sock_spec, "config-get")
    if reply is None or reply.get("result") != 0:
        return None
    arguments = reply.get("arguments")
    section = arguments.get("Dhcp4") if isinstance(arguments, dict) else None
    if not isinstance(section, dict):
        return None
    loggers = section.get("loggers")
    loggers = [] if loggers is None else loggers
    if not isinstance(loggers, list):
        return None
    entry = next((x for x in loggers if isinstance(x, dict) and x.get("name") == _INV_LOGGER), None)
    if entry is None:
        return {"present": False, "severity": None, "debuglevel": None, "marker": None}
    context = entry.get("user-context")
    marker = context.get(_INV_KEY) if isinstance(context, dict) else None
    return {"present": True, "severity": entry.get("severity"), "debuglevel": entry.get("debuglevel"), "marker": marker if isinstance(marker, dict) else None}


def _daemon_matches(seen, file_entry):
    """Does the RUNNING logger (`seen`, from config-get) show the logger the restored FILE has (`file_entry`, `_logger_entry` of the file the helper wrote)? Jen's `_is_original` asks the
    same of the marker's restore object; here the target is the FILE, so a logger a person changed since is verified too, and a file that itself says DEBUG/55 (the operator's own level,
    recorded as the restore object) matches a daemon that shows exactly that. A marker still carried is never a match. A key the file does not have is Kea's default: all that can be said
    is that it is not the investigation value."""
    if seen is None or seen.get("marker") is not None:
        return False
    if file_entry is None:
        return not seen["present"]
    if not seen["present"]:
        return False
    shown = str(seen.get("severity") or "").upper()
    want_sev, want_lvl = file_entry.get("severity"), file_entry.get("debuglevel")
    sev_ok = (shown != "DEBUG") if want_sev is None else shown == str(want_sev).upper()
    lvl_ok = (seen.get("debuglevel") != 55) if want_lvl is None else seen.get("debuglevel") == want_lvl
    return sev_ok and lvl_ok


class _LogCursor:
    """Kea's log as evidence: where the file was before the signal, and what has been written since - following the file by IDENTITY (device, inode), not by name alone, and reading
    incrementally so a flood at DEBUG 55 cannot push the one line that matters past a fixed window. Bounded: `_LOG_READ_MAX` per read, `_LOG_SCAN_MAX` per verification. A line is counted
    once and an id is never cut: the unterminated tail of one read is kept and joined to the next (and flushed when the file it belonged to is rotated away)."""

    def __init__(self, path):
        self.path, self.scanned, self.exhausted, self.partial = path, 0, False, b""
        st = self._stat(path)
        self.usable = st is not None
        self.ident = (st.st_dev, st.st_ino) if st else None
        self.pos = st.st_size if st else 0

    @staticmethod
    def _stat(path):
        try:
            return os.stat(path)
        except OSError:
            return None

    def _read(self, path, start):
        """(bytes, count) past `start`, or (None, 0) when the file cannot be read."""
        try:
            with open(path, "rb") as f:
                f.seek(start)
                data = f.read(_LOG_READ_MAX)
        except OSError:
            return None, 0
        self.scanned += len(data)
        return data, len(data)

    def _split(self, data, final=False):
        """The complete lines of `self.partial + data`; the unterminated tail stays in `partial` (unless `final`: its file will not grow any more)."""
        pieces = (self.partial + data).split(b"\n")
        self.partial = pieces.pop()
        if final and self.partial:
            pieces.append(self.partial)
            self.partial = b""
        return [p.decode("utf-8", "replace").rstrip("\r") for p in pieces]

    def new_lines(self):
        """The lines written since the last call (all of them, in as many reads as it takes). None when the log cannot be read. Once `_LOG_SCAN_MAX` bytes have been scanned `exhausted`
        is True and nothing more is returned: the verification is then unconfirmed, never guessed."""
        if self.exhausted:
            return []
        st = self._stat(self.path)
        if st is None:
            return None
        lines = []
        if self.ident is not None and (st.st_dev, st.st_ino) != self.ident:
            # rotated by rename (logrotate; Kea's own maxsize/maxver): the file we were reading is now `<path>.1` - finish it from where we were, then the new file from its start
            old = self._stat(self.path + ".1")
            rest = b""
            if old is not None and (old.st_dev, old.st_ino) == self.ident:
                at = self.pos
                while True:
                    chunk, n = self._read(self.path + ".1", at)
                    if not chunk:
                        break
                    rest += chunk
                    at += n
                    if n < _LOG_READ_MAX:
                        break
            lines += self._split(rest, final=True)
            self.ident, self.pos = (st.st_dev, st.st_ino), 0
        elif st.st_size < self.pos:
            lines += self._split(b"", final=True)
            self.pos = 0  # truncated in place (copytruncate)
        while True:
            chunk, n = self._read(self.path, self.pos)
            if chunk is None:
                return None
            lines += self._split(chunk)
            self.pos += n
            if self.scanned >= _LOG_SCAN_MAX:
                self.exhausted = True
                break
            if n < _LOG_READ_MAX:
                break
        return lines


def _await_reload(sock, cursor, file_entry):
    """After the SIGHUP: ("ok", evidence, None) | ("fail", None, line) | ("none", None, started_line). The socket is the arbiter for the WHOLE verification: once the daemon has
    answered even once, only its answer can verify - a completion line in the log after that, or a silence after that, is not evidence. The log's completion id counts only when the
    daemon never answered. Wall-clock bounded."""
    deadline, answered, started = _monotonic() + _HUP_WAIT_S, False, None
    while True:
        seen = _daemon_logger_now(sock) if sock is not None else None
        answered = answered or seen is not None
        if seen is not None and _daemon_matches(seen, file_entry):
            return "ok", "config-get", None
        if cursor is not None:
            lines = cursor.new_lines()
            if lines:
                failed = _find_id(lines, _RELOAD_FAIL_IDS)
                if failed:
                    return "fail", None, failed
                started = started or _find_id(lines, _RELOAD_STARTED_IDS)
                if not answered and _find_id(lines, _RELOAD_OK_IDS):
                    return "ok", "log", None
        if _monotonic() >= deadline:
            return "none", None, started
        _sleep(0.5)


def _await_restart(unit, before_pid, sock, cursor, file_entry):
    """After `systemctl restart`: ("ok", "config-get" | "process", None) | ("fail", None, line) | ("none", None, None). `process` - a NEW active main pid, free of a start-failure id for
    `_RESTART_SETTLE_S` - is evidence ONLY for a daemon that never answered during this verification: one that answered is judged by its answer alone. Wall-clock bounded."""
    deadline, answered, fresh_since = _monotonic() + _RESTART_WAIT_S, False, None
    while True:
        _sleep(0.5)
        if cursor is not None:
            lines = cursor.new_lines()
            failed = _find_id(lines, _START_FAIL_IDS) if lines else None
            if failed:
                return "fail", None, failed
        pid = _unit_main_pid(unit)
        if pid > 0 and pid != before_pid and _unit_state(unit) == "active":
            fresh_since = fresh_since if fresh_since is not None else _monotonic()
            seen = _daemon_logger_now(sock) if sock is not None else None
            answered = answered or seen is not None
            if seen is not None and _daemon_matches(seen, file_entry):
                return "ok", "config-get", None
            if not answered and _monotonic() - fresh_since >= _RESTART_SETTLE_S:
                return "ok", "process", None
        else:
            fresh_since = None
        if _monotonic() >= deadline:
            return "none", None, None


def _reload_daemon(service, state, config):
    """Make the running daemon re-read its file AND PROVE IT - (how, evidence, error). `config` is the file the helper has on disk (the restored one): the target is THAT, so a logger a
    person changed since is verified too. The proof, in order: the running daemon's own `config-get` shows the file's logger; Kea's completion id past the pre-signal position (only when no
    socket answered); after the ONE restart, a NEW active process. A daemon that already runs the file is accepted without a signal."""
    unit = _resolve_unit(service, "status")
    if unit is None:
        return None, None, "no Kea unit was found on this host"
    sock = _control_socket(config)
    file_entry = _logger_entry(config)
    cursor = None
    for candidate in (state.get("log_path"), _file_log_path(config)):  # the stored path first; the file's own output when that no longer reads
        if candidate and _allowed_log_path(candidate):
            trial = _LogCursor(candidate)
            if trial.usable:
                cursor = trial
                break
    if sock is None and cursor is None:
        return None, None, (
            "the host has no way to see whether Kea re-read its file: no unix or local http control socket in the config and no readable log file"
        )
    if sock is not None and _daemon_matches(_daemon_logger_now(sock), file_entry):
        return "reload", "config-get", None  # the daemon runs the file already: a person reloaded, or the other of two concurrent restores did
    pid = _unit_main_pid(unit)
    started = None
    if pid > 0:
        try:
            os.kill(pid, _SIGHUP)
        except OSError:
            pid = 0  # no such process: the unit is not really running; fall through to the restart
        else:
            verdict, evidence, extra = _await_reload(sock, cursor, file_entry)
            if verdict == "ok":
                return "reload", evidence, None
            if verdict == "fail":
                return None, None, f"Kea refused the restored config: {extra}"[:400]
            started = extra  # quoted below, never evidence
    note = f"; the reload started ({started.strip()[:160]}) and nothing shows it completed" if started else ""
    if int(state.get("restarts") or 0) >= 1:
        return None, None, "nothing shows Kea re-read the restored file and the unit was already restarted once for this state: not restarting again" + note
    state["restarts"] = int(state.get("restarts") or 0) + 1
    with contextlib.suppress(OSError):  # the budget is spent ON DISK before the restart is issued: a helper killed between the restart and the end of this restore does not restart Kea again
        _save_state(service, state)
    proc = _run_bin("systemctl", ["restart", unit], capture_output=True, text=True)
    if proc is None or proc.returncode != 0:
        tail = "\n".join(((proc.stderr or proc.stdout) if proc else "").splitlines()[-3:])
        return None, None, f"systemctl restart {unit} failed: {tail}"
    verdict, evidence, extra = _await_restart(unit, pid, sock, cursor, file_entry)
    if verdict == "ok":
        return "restart", evidence, None
    if verdict == "fail":
        return None, None, f"restarted, but Kea refused the restored config: {extra}"[:400]
    return None, None, "restarted, but neither Kea's own answer, its log nor a fresh active process shows the restored file running" + note


def _restore_state(service, state):
    """The restore routine - shared by `investigation-disarm`, the timer and boot. Under the lock it RE-READS the state (two restores in the same second must not both act: the second would
    spend the one restart on a daemon that is already restored), reads the config, puts the logger back from the STATE's `restore`, validates with `-t` as the daemon, writes the file
    privately (the previous one kept as `.jen_backup`) and asks the daemon to re-read it, verified by `_reload_daemon`'s contract. Updates and saves the state: `restored_at`, `how`
    and `evidence` on success, `last_error` on failure (the next tick retries). Returns (ok, how, detail)."""
    path = state["path"]
    with _locked(path):
        kind, fresh = _read_state(service)
        if kind != "ok":
            return False, None, "the state file changed underneath this restore" + (f" ({fresh})" if kind == "bad" else "")
        if fresh.get("restored_at"):
            return True, fresh.get("how"), "already restored"
        state = fresh
        try:
            with open(path, "rb") as f:
                raw = f.read()
            st = os.stat(path)
            config = json.loads(raw.decode("utf-8"))
        except (OSError, ValueError) as e:
            return _restore_failed(service, state, f"the config could not be read: {e}")
        if not isinstance(config, dict):
            return _restore_failed(service, state, "the config is not a JSON object")
        if not state.get("log_path"):
            state["log_path"] = _file_log_path(config)  # a record armed by build 15 (or without a log): the log path comes from the file's own logger
            state["verified_by_build"] = HELPER_BUILD
        new_cfg, code = _restore_logger(config, state["restore"])
        if code == "ok":
            ok, result = _run_kea_test(service, path, new_cfg, [])
            if not ok:
                return _restore_failed(service, state, f"{result.get('error')}: {result.get('detail', '')}".strip(": "))
            try:
                _install_private(path + ".jen_backup", raw, st.st_uid, st.st_gid, st.st_mode & 0o777)
                _install_private(path, json.dumps(new_cfg, indent=2).encode("utf-8"), st.st_uid, st.st_gid, st.st_mode & 0o777)
            except OSError as e:
                return _restore_failed(service, state, f"the config could not be written: {e}")
        how, evidence, error = _reload_daemon(service, state, new_cfg if code == "ok" else config)
        if error or how not in ("reload", "restart") or evidence not in _EVIDENCE:
            return _restore_failed(service, state, error or "the reload was not verified")
        # the ONE place `restored_at` is written: after a VERIFIED how AND the evidence that verified it
        state.update(
            restored_at=_now().isoformat(timespec="seconds"),
            how=how,
            evidence=evidence,
            verified_by_build=HELPER_BUILD,
            last_error=None,
            needs_hand=False,
        )
        _save_state(service, state)
        return True, how, ""


def _restore_failed(service, state, detail):
    state["last_error"] = str(detail)[:500]
    state["attempts"] = int(state.get("attempts") or 0) + 1
    if state["attempts"] >= _MAX_UNCONFIRMED_TICKS:
        state["needs_hand"] = True  # Jen's Health says so; `sudo jen-kea-helper --self-restore --now` is the by-hand step once the cause is fixed
    with contextlib.suppress(OSError):  # the failure is returned either way; the state file is the report, not the safety
        _save_state(service, state)
    return False, None, state["last_error"]


def _arm_fields(payload):
    """Validate an `investigation-arm` payload: (state dict, None) or (None, error token)."""
    service, path = payload.get("service"), payload.get("path")
    if service != "dhcp4" or not _allowed_conf_path(path):
        return None, "not-allowed"
    until = _parse_iso(payload.get("until"))
    if until is None or until > _now() + _ARM_MAX_AHEAD:
        return None, "bad-until"
    restore = payload.get("restore")
    if not _restore_shape_ok(restore):
        return None, "bad-restore"
    log_path = payload.get("log_path")
    if log_path not in (None, "") and not _allowed_log_path(log_path):
        return None, "bad-log-path"  # (build 17: optional - the daemon's own socket can answer without a log - but a malformed one is still refused)
    log_path = log_path or None
    jen = payload.get("jen")
    if jen is not None and (
        not isinstance(jen, dict)
        or set(jen) - {"server_id", "name"}
        or any(not isinstance(v, (str, int)) or len(str(v)) > 200 for v in jen.values())
    ):
        return None, "bad-jen"
    return {
        "service": service,
        "path": path,
        "until": until.isoformat(timespec="seconds"),
        "restore": restore,
        "armed_at": _now().isoformat(timespec="seconds"),
        "restored_at": None,
        "how": None,
        "last_error": None,
        "restarts": 0,
        "attempts": 0,
        "needs_hand": False,
        "log_path": log_path,
        "jen": jen or {},
    }, None


def op_investigation_arm(payload):
    state, error = _arm_fields(payload)
    if state is None:
        return {"ok": False, "error": error}, None
    path = state["path"]
    try:
        with open(path, "rb") as f:
            config = json.loads(f.read().decode("utf-8"))
    except (OSError, ValueError):
        config = None
    log_path = state["log_path"] or (_file_log_path(config) if isinstance(config, dict) else None)
    cursor = _LogCursor(log_path) if log_path else None
    has_log = cursor is not None and cursor.usable
    if _control_socket(config) is None and not has_log:
        return {
            "ok": False,
            "error": "no-evidence",
            "detail": "the host would have no way to see whether Kea re-read its file: no unix or local http control socket in the config and no readable log file for the kea-dhcp4 logger",
        }, path
    if has_log and not state["log_path"]:
        state["log_path"] = log_path
    with _locked(path):
        # build 16 (Q167): the host's record is authoritative. An UNRESOLVED one (no `restored_at`) is never replaced by whatever a caller sends - a Jen restored from an older backup, a
        # second Jen, a stale sweep: the same session again is idempotent, the same restore with a LATER deadline is an extension, anything else is refused with the record.
        kind, existing = _read_state("dhcp4")
        if kind == "bad":
            return {"ok": False, "error": "armed", "existing": {"unreadable": True, "detail": existing}, "detail": _bad_state_sentence(existing)}, path
        existing = existing if kind == "ok" else None
        idempotent = False
        if existing is not None and not existing.get("restored_at"):
            same = existing.get("path") == state["path"] and existing.get("restore") == state["restore"]
            old_until, new_until = _parse_iso(existing.get("until")), _parse_iso(state["until"])
            if same and old_until is not None and new_until == old_until:
                idempotent = True
            elif same and old_until is not None and new_until is not None and new_until > old_until:
                state["extended_from"] = existing.get("until")
                for k in ("restarts", "attempts", "needs_hand", "last_error", "verified_by_build"):  # an extension is the same session: its spent restart and its failures are not forgotten
                    if k in existing:
                        state[k] = existing[k]
            else:
                return {"ok": False, "error": "armed", "existing": existing}, path
        try:
            _ensure_state_dir()
            if not idempotent:
                _save_state("dhcp4", state)
        except OSError as e:
            return {"ok": False, "error": "write-failed", "detail": str(e)}, path
        timer, detail = _ensure_timer()
    reply = {"ok": True, "timer": timer, "until": existing["until"] if idempotent else state["until"]}
    if idempotent:
        reply["idempotent"] = True
    if state.get("extended_from"):
        reply["extended_from"] = state["extended_from"]
    if detail:
        reply["detail"] = detail
    return reply, path


def op_investigation_disarm(payload):
    service, path = payload.get("service"), payload.get("path")
    if service != "dhcp4" or not _allowed_conf_path(path):
        return {"ok": False, "error": "not-allowed"}, None
    kind, state = _read_state(service)
    if kind == "absent":
        return {"ok": True, "restored": False, "how": "nothing", "detail": "not armed"}, path
    if kind == "bad":
        return {"ok": False, "error": "bad-state", "detail": _bad_state_sentence(state)}, path
    if state["path"] != path:
        return {"ok": False, "error": "bad-state", "detail": "the state file is not one this helper wrote for this config"}, path
    if state.get("restored_at"):
        return {"ok": True, "restored": False, "how": state.get("how") or "nothing", "detail": "already restored"}, path
    ok, how, detail = _restore_state(service, state)
    if not ok:
        return {"ok": False, "error": "restore-failed", "detail": detail}, path
    return {"ok": True, "restored": True, "how": how, "detail": ""}, path


def _timer_status():
    """(active, enabled) of the host's own timer, asked of systemd now."""
    active = _run_bin("systemctl", ["is-active", f"{_TIMER_NAME}.timer"], capture_output=True, text=True)
    enabled = _run_bin("systemctl", ["is-enabled", f"{_TIMER_NAME}.timer"], capture_output=True, text=True)
    return (
        active is not None and active.stdout.strip() == "active",
        enabled is not None and enabled.stdout.strip() in ("enabled", "enabled-runtime", "static", "alias"),
    )


def op_investigation_timer(payload):
    """`{action: "ensure"}` - install (when different) and start the timer again: what the arm does, without touching the state. A timer someone stopped is what this repairs."""
    if payload.get("action") != "ensure":
        return {"ok": False, "error": "not-allowed"}, None
    timer, detail = _ensure_timer()
    reply = {"ok": timer == "systemd", "timer": timer}
    if detail:
        reply["detail"] = detail
    return reply, None


def _status_view(state):
    armed = bool(state) and not state.get("restored_at")
    timer_active, timer_enabled = _timer_status() if armed else (None, None)
    last_error = state.get("last_error")
    if armed and timer_active is False:
        last_error = "Restoration timer is not active"
    return {
        "armed": armed,
        "timer_active": timer_active,
        "timer_enabled": timer_enabled,
        "needs_hand": bool(state.get("needs_hand")),
        "attempts": state.get("attempts", 0),
        "log_path": state.get("log_path"),
        "evidence": state.get("evidence"),
        "verified_by_build": state.get("verified_by_build"),
        "extended_from": state.get("extended_from"),
        "path": state.get("path"),
        "until": state.get("until"),
        "armed_at": state.get("armed_at"),
        "restored_at": state.get("restored_at"),
        "how": state.get("how"),
        "last_error": last_error,
        "restore": state.get("restore"),
        "jen": state.get("jen") or {},
    }


def op_investigation_status(payload):
    service = payload.get("service")
    if service != "dhcp4":
        return {"ok": False, "error": "not-allowed"}, None
    kind, state = _read_state(service)
    if kind == "absent":
        return {"ok": True, "armed": False}, None
    if kind == "bad":
        return {
            "ok": False,
            "error": "bad-state",
            "armed": None,
            "detail": _bad_state_sentence(state),
            "state_file": _state_path(service),
        }, _state_path(service)
    return {"ok": True, **_status_view(state)}, state.get("path")


def _self_restore(force=False):
    """The timer's tick (and `--self-restore --now` by hand): for every armed state whose `until` has passed - every armed state with `force` - run the restore routine.
    A state file that is not one `investigation-arm` could have written is reported and never acted on."""
    results = []
    try:
        names = sorted(os.listdir(_STATE_DIR))
    except OSError:
        return {"ok": True, "checked": 0, "restored": [], "failed": []}
    failed = []
    for name in names:
        m = _STATE_FILE_RE.match(name)
        if not m:
            continue
        service = m.group(1)
        kind, state = _read_state(service)
        if kind == "absent":
            continue
        if kind == "bad":
            failed.append({"service": service, "error": f"the state file is not usable: {state}"})
            continue
        if state.get("restored_at"):
            continue
        due = _parse_iso(state.get("until"))
        if not force and due is not None and due > _now():
            continue
        ok, how, detail = _restore_state(service, state)
        (results if ok else failed).append({"service": service, "how": how} if ok else {"service": service, "error": detail})
    return {"ok": not failed, "checked": len(names), "restored": results, "failed": failed}


_OPS = {
    "version": op_version,
    "read-config": op_read_config,
    "test-config": op_test_config,
    "apply-config": op_apply_config,
    "remove-config": op_remove_config,
    "service": op_service,
    "tail-log": op_tail_log,
    "install-package": op_install_package,
    "install-tls": op_install_tls,
    "update": op_update,
    "investigation-arm": op_investigation_arm,
    "investigation-disarm": op_investigation_disarm,
    "investigation-status": op_investigation_status,
    "investigation-timer": op_investigation_timer,
}


# ── Entry point ─────────────────────────────────────────────────────────────


def _emit(stdout, stderr, op, result, exit_code, path=None):
    if isinstance(result, dict):
        result.setdefault("helper_version", HELPER_VERSION)
        result.setdefault("helper_build", HELPER_BUILD)
    stdout.write(json.dumps(result))
    stdout.write("\n")
    stdout.flush()
    status = "ok" if result.get("ok") else "fail"
    line = f"jen-kea-helper: {op or '(no op)'} {status}"
    if path:
        line += f" {path}"
    stderr.write(line + "\n")
    stderr.flush()
    return exit_code


def main(argv=None, stdin=None, stdout=None, stderr=None):
    argv = sys.argv if argv is None else argv
    stdin = sys.stdin if stdin is None else stdin
    stdout = sys.stdout if stdout is None else stdout
    stderr = sys.stderr if stderr is None else stderr

    op = argv[1] if len(argv) > 1 else ""

    if op == "--self-restore":
        # build 15: the timer's tick - argv only, no stdin, nothing to parse; `--now` restores every armed state without waiting for its `until`
        try:
            result = _self_restore(force="--now" in argv[2:])
        except Exception as e:  # noqa: BLE001 - a tick must report, never traceback
            result = {"ok": False, "error": "helper-exception", "detail": str(e)}
        # build 16: a failed restore is a failed unit (systemd keeps scheduling a oneshot that exited nonzero, so the next tick still runs)
        return _emit(stdout, stderr, op, result, 0 if result.get("ok") else 1)

    raw = stdin.read(MAX_STDIN + 1)
    if len(raw) > MAX_STDIN:
        return _emit(stdout, stderr, op, {"ok": False, "error": "stdin-too-large"}, 2)

    try:
        payload = json.loads(raw) if raw.strip() else {}
    except ValueError as e:
        return _emit(stdout, stderr, op, {"ok": False, "error": "bad-json", "detail": str(e)}, 2)
    if not isinstance(payload, dict):
        return _emit(stdout, stderr, op, {"ok": False, "error": "bad-json", "detail": "stdin is not a JSON object"}, 2)

    handler = _OPS.get(op)
    if handler is None:
        return _emit(stdout, stderr, op, {"ok": False, "error": "unknown-op"}, 2)

    try:
        result, path = handler(payload)
    except Exception as e:  # noqa: BLE001 — never let a bug become a stray traceback on stdout
        result, path = {"ok": False, "error": "helper-exception", "detail": str(e)}, None

    return _emit(stdout, stderr, op, result, 0, path)


if __name__ == "__main__":
    sys.exit(main())
