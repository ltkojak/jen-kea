def op_version(_payload):
    v = sys.version_info
    return {
        "ok": True,
        "helper_version": HELPER_VERSION,
        "helper_build": HELPER_BUILD,
        "python": f"{v.major}.{v.minor}.{v.micro}",
    }, None


def op_read_config(payload):
    service = payload.get("service")
    path = payload.get("path")
    if not _valid_service(service) or not _allowed_conf_path(path):
        return {"ok": False, "error": "not-allowed"}, None
    if not os.path.isfile(path):
        return {"ok": False, "error": "missing"}, path
    try:
        with open(path, "rb") as f:
            raw = f.read()
        return {"ok": True, "config": json.loads(raw), "sha256": hashlib.sha256(raw).hexdigest()}, path
    except (OSError, ValueError) as e:
        return {"ok": False, "error": "invalid-json", "detail": str(e)}, path


def op_test_config(payload):
    service = payload.get("service")
    path = payload.get("path")
    if not _valid_service(service) or not _allowed_conf_path(path):
        return {"ok": False, "error": "not-allowed"}, None
    config = payload.get("config")
    if not isinstance(config, dict):
        return {"ok": False, "error": "not-allowed"}, path
    _ok, result = _run_kea_test(service, path, config, payload.get("tls_paths") or [])
    return result, path


def op_apply_config(payload):
    service = payload.get("service")
    path = payload.get("path")
    if not _valid_service(service) or not _allowed_conf_path(path):
        return {"ok": False, "error": "not-allowed"}, None
    config = payload.get("config")
    if not isinstance(config, dict):
        return {"ok": False, "error": "not-allowed"}, path
    allow_overwrite = bool(payload.get("allow_overwrite", True))
    # None → no concurrency guard (v1 callers). "" → "must not exist".
    # "<hex>" → the file must currently hash to exactly this.
    expect = payload.get("expect_sha256")

    lock_fd = None
    if expect is not None:
        import fcntl  # Linux-only; guarded here so py_compile works on Windows

        lock_fd = os.open(path + ".jen_lock", os.O_CREAT | os.O_RDWR, 0o600)
        try:
            os.fchmod(lock_fd, 0o600)
        except OSError:
            pass
        fcntl.flock(lock_fd, fcntl.LOCK_EX)  # held until we close the fd

    try:
        if expect is not None:
            current = _file_sha256(path)  # None when the file is absent
            conflict = (current is not None) if expect == "" else (current != expect)
            if conflict:
                return {"ok": False, "error": "conflict", "sha256": current or ""}, path

        ok, result = _run_kea_test(service, path, config, payload.get("tls_paths") or [])
        if not ok:
            return result, path

        exists = os.path.exists(path)
        if exists and not allow_overwrite:
            return {"ok": False, "error": "exists"}, path

        tmp = path + ".jen_apply_tmp"
        try:
            with open(tmp, "w") as f:
                json.dump(config, f, indent=2)

            backup = None
            if exists:
                backup = path + ".jen_backup"
                shutil.copy2(path, backup)
                st = os.stat(path)
                try:
                    os.chown(tmp, st.st_uid, st.st_gid)
                except (OSError, AttributeError):
                    pass
                os.chmod(tmp, st.st_mode & 0o777)
            else:
                # A brand-new config: match what `json.dump` under the old
                # sudo-python3 path produced. Ubuntu's kea runs as `_kea` and
                # must be able to read it.
                os.chmod(tmp, 0o644)
                try:
                    os.chown(tmp, 0, 0)
                except (OSError, AttributeError):
                    pass

            os.replace(tmp, path)
            return {"ok": True, "backup": backup, "sha256": _file_sha256(path)}, path
        finally:
            if os.path.exists(tmp):
                try:
                    os.unlink(tmp)
                except OSError:
                    pass
    finally:
        if lock_fd is not None:
            os.close(lock_fd)


def _resolve_unit(service, action):
    """The installed unit name for `service` — `kea-{fam}-server` on ISC
    packages, `isc-kea-{fam}-server` on older Debian/Ubuntu ones (`fam` is
    "dhcp4"/"dhcp6"/"dhcp-ddns" — Kea's own unit-naming family, not Jen's
    "d2" service name). Tries each with `systemctl show -p LoadState`;
    returns the first that is `loaded`, else None (including "systemctl
    itself could not be found under _BIN_DIRS", the old OSError-catch
    case)."""
    fam = _SERVICE_UNIT_FAM.get(service, "dhcp6")
    for unit in (f"kea-{fam}-server", f"isc-kea-{fam}-server"):
        proc = _run_bin("systemctl", ["show", "-p", "LoadState", "--value", unit], capture_output=True, text=True)
        if proc is None:
            return None
        if proc.stdout.strip() == "loaded":
            return unit
    return None


def _unit_state(unit):
    proc = _run_bin("systemctl", ["is-active", unit], capture_output=True, text=True)
    if proc is None:
        return "unknown"
    return proc.stdout.strip() or "unknown"


def op_service(payload):
    service = payload.get("service")
    action = payload.get("action")
    if not _valid_service(service) or action not in ("restart", "enable", "disable", "status"):
        return {"ok": False, "error": "not-allowed"}, None

    unit = _resolve_unit(service, action)
    if unit is None:
        return {"ok": False, "error": "no-unit"}, None

    if action == "status":
        return {"ok": True, "unit": unit, "state": _unit_state(unit)}, unit

    args = [action]
    if action in ("enable", "disable"):
        args.append("--now")
    args.append(unit)
    proc = _run_bin("systemctl", args, capture_output=True, text=True)
    if proc is None:
        return {"ok": False, "error": "systemctl", "detail": "systemctl not found under _BIN_DIRS"}, unit
    if proc.returncode != 0:
        tail = "\n".join((proc.stderr or proc.stdout or "").splitlines()[-5:])
        return {"ok": False, "error": "systemctl", "detail": tail}, unit
    return {"ok": True, "unit": unit, "state": _unit_state(unit)}, unit


def op_tail_log(payload):
    path = payload.get("path")
    if not _allowed_log_path(path):
        return {"ok": False, "error": "not-allowed"}, None
    try:
        lines = int(payload.get("lines", 200))
    except (TypeError, ValueError):
        lines = 200
    lines = max(1, min(lines, 1000))
    if not os.path.isfile(path):
        return {"ok": False, "error": "missing"}, path
    try:
        # Bounded memory: only the last `lines` lines are ever held, decoded
        # per line with errors="replace", however large the log file is.
        with open(path, encoding="utf-8", errors="replace") as f:
            content = [ln.rstrip("\r\n") for ln in collections.deque(f, maxlen=lines)]
    except OSError as e:
        return {"ok": False, "error": "unreadable", "detail": str(e)}, path
    return {"ok": True, "lines": content}, path


def op_install_package(payload):
    service = payload.get("service")
    if not _valid_service(service):
        return {"ok": False, "error": "not-allowed"}, None
    package = f"kea-{_SERVICE_UNIT_FAM.get(service, 'dhcp6')}-server"
    apt_env = {**_CLEAN_ENV, "DEBIAN_FRONTEND": "noninteractive"}
    out = []
    ok = True
    for args in (["update", "-qq"], ["install", "-y", package]):
        binary = _find_bin("apt-get")
        if binary is None:
            return {"ok": False, "output": "apt-get not found under _BIN_DIRS"}, package
        try:
            proc = subprocess.run([binary, *args], capture_output=True, text=True, env=apt_env)  # nosec B603
        except OSError as e:
            return {"ok": False, "output": str(e)}, package
        out.append((proc.stdout or "") + (proc.stderr or ""))
        if proc.returncode != 0:
            ok = False
            break
    tail = "\n".join("".join(out).strip().splitlines()[-15:])
    return {"ok": ok, "output": tail}, package


def _pem_ok(name, body):
    """Marker-and-size guard only (see the v4 note in the module doc)."""
    if not isinstance(body, str) or not body or len(body) > _PEM_MAX:
        return False
    if name == "server.key":
        return bool(_PEM_KEY_RE.match(body)) and "CERTIFICATE" not in body
    return bool(_PEM_CERTS_RE.match(body)) and "PRIVATE KEY" not in body


def _daemon_group(service):
    """(name, gid) the daemon's key must be readable by: the unit's
    `User=` (its primary group), else `_kea` (Ubuntu/Debian packages),
    else root. v5.68.0-beta.6 (Q141): this used to say "ISC's own packages run the daemons as
    root" - never checked, and not what a real ISC deb shows: on Kea 3.0.4 from ISC's own
    packages `/usr/sbin/kea-dhcp4` is owned `_kea:_kea` (mode 0750), the account the daemon
    is meant to run as. ISC's container images (3.0.3, 3.2.0, 3.3.1, recorded by tests/kea_compat
    `test_binary_facts`) ship it owned by their service account `kea` (uid 100, mode 0754) while the
    daemon process itself runs as root; the fallback to root below is only for a host where neither
    the unit nor `_kea` resolves."""
    user = ""
    unit = _resolve_unit(service, "status")
    if unit:
        proc = _run_bin("systemctl", ["show", "-p", "User", "--value", unit], capture_output=True, text=True)
        user = (proc.stdout or "").strip() if proc else ""
    try:
        import pwd
    except ImportError:  # not a POSIX host (only ever the test harness)
        return "root", 0
    for cand in (user, "_kea"):
        if not cand:
            continue
        try:
            return cand, pwd.getpwnam(cand).pw_gid
        except KeyError:
            continue
    return "root", 0


def _chown(path, uid, gid):
    try:
        os.chown(path, uid, gid)
    except (OSError, AttributeError):
        pass


def op_install_tls(payload):
    service = payload.get("service")
    files = payload.get("files")
    if not _valid_service(service) or not isinstance(files, dict):
        return {"ok": False, "error": "not-allowed"}, None
    if set(files) != set(_TLS_FILES):
        return {"ok": False, "error": "not-allowed"}, None
    for name in _TLS_FILES:
        if not _pem_ok(name, files[name]):
            return {"ok": False, "error": "bad-pem", "file": name}, None

    target_dir = os.path.join(_TLS_ROOT, service)  # a real fs path (remote = Linux), not a validated one
    for p in (_TLS_ROOT, target_dir):
        if os.path.islink(p):
            return {"ok": False, "error": "symlink", "path": p}, p
    os.makedirs(target_dir, mode=0o755, exist_ok=True)
    _chown(_TLS_ROOT, 0, 0)
    _chown(target_dir, 0, 0)
    try:
        os.chmod(_TLS_ROOT, 0o755)
        os.chmod(target_dir, 0o755)
    except OSError:
        pass

    group, gid = _daemon_group(service)
    written = {}
    for name in _TLS_FILES:
        target = os.path.join(target_dir, name)
        if os.path.islink(target):
            return {"ok": False, "error": "symlink", "path": target}, target
        tmp = target + ".jen_tmp"
        try:
            with open(tmp, "w") as f:
                f.write(files[name])
            _chown(tmp, 0, gid)
            os.chmod(tmp, 0o640 if name == "server.key" else 0o644)
            os.replace(tmp, target)
        except OSError as e:
            return {"ok": False, "error": "write-failed", "path": target, "detail": str(e)}, target
        finally:
            if os.path.exists(tmp):
                try:
                    os.unlink(tmp)
                except OSError:
                    pass
        written[name] = target
    return {"ok": True, "paths": written, "owner": f"root:{group}"}, target_dir


# ── v6 (v5.66.0, Q103): signed self-update ────────────────────────────────────

_SELF_PATH = "/usr/local/sbin/jen-kea-helper"
# The optional rotation/test hook (see the module doc). A module-level constant so
# tests monkeypatch it exactly like _TLS_ROOT.
_EXTRA_SIGNERS = "/etc/jen-kea-helper/allowed_signers"
_UPDATE_SIGNATURE_IDENTITY = "release@jen"
_UPDATE_SIGNATURE_NAMESPACE = "jen-kea-helper"
_UPDATE_MAX_HELPER = 512 * 1024
_UPDATE_MAX_SIGNERS = 8 * 1024
_HELPER_VERSION_RE = re.compile(rb"^HELPER_VERSION = (\d+)$", re.M)
_HELPER_BUILD_RE = re.compile(rb"^HELPER_BUILD = (\d+)$", re.M)
# v5.66.0-beta.2 (Q104) — the candidate's own preflight/postflight probe. /usr/bin/python3
# is hardcoded on purpose, not resolved through _find_bin: it is where every target this
# ships to (Ubuntu, and the system suite's Alpine image) puts it, and it is the exact same
# path the legacy grant has always named — the one fixed interpreter path this file can
# assume exists without having found it some other way first.
_PREFLIGHT_PYTHON = "/usr/bin/python3"

# v5.26.0's permanent trust root, copied here verbatim — see jen-update-root.py's own
# RELEASE_SIGNERS for the full rotation note. tests/test_kea_helper.py diffs the two
# byte for byte so they can never silently drift.
RELEASE_SIGNERS = "release@jen ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFXk5NbQwUy85pHCzLfOwPisL0JGLCOrHuRjRZSf25vD"


def _extra_signers_owner_ok(path):
    """True iff `path` is a REGULAR file, owned root:root, with no group/other write bit —
    a separate function (rather than inline in `_extra_signers_text`) so a test, which can't
    chown a real file to root without being root itself, can monkeypatch this one check
    directly instead of faking filesystem ownership."""
    try:
        st = os.lstat(path)
    except OSError:
        return False
    if not stat.S_ISREG(st.st_mode):
        return False
    return st.st_uid == 0 and st.st_gid == 0 and not (st.st_mode & 0o022)


def _extra_signers_text():
    """The optional local addition to RELEASE_SIGNERS — a rotation hook (list the new key
    here for one release before switching which key release.yml signs with) and a test
    double (a throwaway key, for the system suite). Returns "" for anything short of a
    small, root-owned, non-writable-by-others regular file: this file existing at all is
    already unusual, and failing closed on a suspicious one is safer than raising."""
    if not _extra_signers_owner_ok(_EXTRA_SIGNERS):
        return ""
    try:
        with open(_EXTRA_SIGNERS, "rb") as f:
            data = f.read(_UPDATE_MAX_SIGNERS + 1)
    except OSError:
        return ""
    if len(data) > _UPDATE_MAX_SIGNERS:
        return ""
    return data.decode("utf-8", "replace")


def _probe_helper_version(path):
    """Run `<path> version` in a throwaway process — the fixed _PREFLIGHT_PYTHON
    interpreter, isolated mode, an empty JSON object on stdin, the fixed _CLEAN_ENV, a 10 s
    timeout — and require exit 0 plus a JSON `{"ok": true, "helper_version": N,
    "helper_build": N}` reply. Used both to preflight a signed candidate BEFORE it replaces
    the live helper, and to postflight the installed path right after. Returns
    (ok, helper_version_or_None, helper_build_or_None, reason) — `reason` is a single line,
    ssh-keygen-style (the first stderr line, or a description of what went wrong), capped at
    200 chars, populated only when ok is False."""
    try:
        proc = subprocess.run(  # nosec B603
            [_PREFLIGHT_PYTHON, "-I", path, "version"],
            input=b"{}",
            capture_output=True,
            timeout=10,
            env=_CLEAN_ENV,
        )
    except (OSError, subprocess.TimeoutExpired) as e:
        return False, None, None, f"{type(e).__name__}: {e}"[:200]
    if proc.returncode != 0:
        first_err = (proc.stderr or b"").decode("utf-8", "replace").splitlines()
        reason = first_err[0] if first_err else f"exited {proc.returncode}"
        return False, None, None, reason[:200]
    try:
        reply = json.loads((proc.stdout or b"").decode("utf-8", "replace"))
    except ValueError:
        return False, None, None, "candidate's version op did not print valid JSON"
    if not isinstance(reply, dict) or reply.get("ok") is not True:
        return False, None, None, "candidate's version op did not answer ok"
    return True, reply.get("helper_version"), reply.get("helper_build"), ""


def op_update(payload):
    helper_b64 = payload.get("helper_b64")
    signature_b64 = payload.get("signature_b64")
    if not isinstance(helper_b64, str) or not isinstance(signature_b64, str):
        return {"ok": False, "error": "not-allowed"}, None
    try:
        candidate = base64.b64decode(helper_b64, validate=True)
        signature = base64.b64decode(signature_b64, validate=True)
    except (binascii.Error, ValueError):
        return {"ok": False, "error": "not-allowed"}, None
    if not candidate or len(candidate) > _UPDATE_MAX_HELPER or len(signature) > _UPDATE_MAX_SIGNERS:
        return {"ok": False, "error": "not-allowed"}, None

    keygen = _find_bin("ssh-keygen")
    if keygen is None:
        return {"ok": False, "error": "no-ssh-keygen"}, None

    tmp_dir = tempfile.mkdtemp(dir=os.path.dirname(_SELF_PATH))
    try:
        sig_path = os.path.join(tmp_dir, "candidate.sig")
        signers_path = os.path.join(tmp_dir, "allowed_signers")
        with open(sig_path, "wb") as f:
            f.write(signature)
        signers_text = RELEASE_SIGNERS.rstrip("\n") + "\n"
        extra = _extra_signers_text()
        if extra:
            signers_text += extra.rstrip("\n") + "\n"
        with open(signers_path, "w") as f:
            f.write(signers_text)

        try:
            proc = subprocess.run(  # nosec B603
                [
                    keygen,
                    "-Y",
                    "verify",
                    "-f",
                    signers_path,
                    "-I",
                    _UPDATE_SIGNATURE_IDENTITY,
                    "-n",
                    _UPDATE_SIGNATURE_NAMESPACE,
                    "-s",
                    sig_path,
                ],
                input=candidate,
                capture_output=True,
                timeout=10,
                env=_CLEAN_ENV,
            )
        except (OSError, subprocess.TimeoutExpired):
            return {"ok": False, "error": "bad-signature"}, None
        if proc.returncode != 0:
            return {"ok": False, "error": "bad-signature"}, None

        vm = _HELPER_VERSION_RE.search(candidate)
        bm = _HELPER_BUILD_RE.search(candidate)
        if not vm or not bm:
            return {"ok": False, "error": "unparseable"}, None
        new_version = int(vm.group(1))
        new_build = int(bm.group(1))
        # v5.66.0-beta.7 (Q109) — two INDEPENDENT checks, both run unconditionally. The old
        # code nested the build check inside "new_version == HELPER_VERSION", so a candidate
        # declaring a HIGHER version skipped the build check entirely and let a lower build
        # through on a protocol bump. HELPER_BUILD orders every file change regardless of
        # HELPER_VERSION — a protocol bump does not reset it — so it is checked here on its
        # own, every time, exactly like the protocol-downgrade check next to it.
        if new_version < HELPER_VERSION:
            return {"ok": False, "error": "not-newer", "detail": "protocol-downgrade"}, None
        if new_build <= HELPER_BUILD:
            return {"ok": False, "error": "not-newer", "detail": "build-not-newer"}, None

        if os.path.islink(_SELF_PATH):
            return {"ok": False, "error": "symlink"}, None
        if not os.path.isfile(_SELF_PATH):
            # update() replaces an installed helper, it never installs one — refuse before
            # any candidate bytes are written or preflighted (v5.66.0-beta.4, Q106).
            return {"ok": False, "error": "not-installed"}, None

        final_tmp = os.path.join(tmp_dir, "final")
        with open(final_tmp, "wb") as f:
            f.write(candidate)
            f.flush()
            os.fsync(f.fileno())

        # ── preflight: the candidate must run and self-report exactly what it declared ──
        pre_ok, pre_version, pre_build, pre_reason = _probe_helper_version(final_tmp)
        if not pre_ok or pre_version != new_version or pre_build != new_build:
            detail = pre_reason or "the candidate's own version op disagreed with what it declared"
            return {"ok": False, "error": "preflight-failed", "detail": detail}, None

        prev_path = _SELF_PATH + ".prev"
        if os.path.islink(prev_path):
            return {"ok": False, "error": "symlink", "path": prev_path}, None
        # _SELF_PATH is guaranteed a plain regular file at this point (checked above), so the
        # rollback copy is now unconditional — there is no longer a "nothing to roll back to"
        # case (v5.66.0-beta.4, Q106).
        shutil.copy2(_SELF_PATH, prev_path)
        _chown(prev_path, 0, 0)
        os.chmod(prev_path, 0o755)

        _chown(final_tmp, 0, 0)
        os.chmod(final_tmp, 0o755)
        os.replace(final_tmp, _SELF_PATH)
        try:
            dir_fd = os.open(os.path.dirname(_SELF_PATH), os.O_RDONLY)
            try:
                os.fsync(dir_fd)
            finally:
                os.close(dir_fd)
        except OSError:
            pass  # best-effort durability only — not every OS supports fsync on a directory fd

        # ── postflight: the INSTALLED path must answer the same way, or roll back ──
        post_ok, post_version, post_build, post_reason = _probe_helper_version(_SELF_PATH)
        if not post_ok or post_version != new_version or post_build != new_build:
            detail = post_reason or "the installed candidate's own version op disagreed after install"
            try:
                os.replace(prev_path, _SELF_PATH)
            except OSError as e:
                # The rollback itself failed — _SELF_PATH may still hold the broken candidate
                # and the old bytes are stranded at prev_path. Never call this postflight-failed
                # (which implies the previous helper is back); name both paths so an
                # administrator knows exactly what to check by hand (v5.66.0-beta.4, Q106).
                return {
                    "ok": False,
                    "error": "rollback-failed",
                    "detail": f"{detail}; restoring the previous helper also failed: {e}",
                    "path": _SELF_PATH,
                    "prev_path": prev_path,
                }, None
            return {"ok": False, "error": "postflight-failed", "detail": detail}, None

        try:
            os.unlink(prev_path)
        except OSError:
            pass

        return {
            "ok": True,
            "installed_version": new_version,
            "installed_build": new_build,
            "previous_version": HELPER_VERSION,
            "previous_build": HELPER_BUILD,
        }, None
    finally:
        shutil.rmtree(tmp_dir, ignore_errors=True)


_OPS = {
    "version": op_version,
    "read-config": op_read_config,
    "test-config": op_test_config,
    "apply-config": op_apply_config,
    "service": op_service,
    "tail-log": op_tail_log,
    "install-package": op_install_package,
    "install-tls": op_install_tls,
    "update": op_update,
}


# ── Entry point ─────────────────────────────────────────────────────────────


def _emit(stdout, stderr, op, result, exit_code, path=None):
    if isinstance(result, dict):
        result.setdefault("helper_version", HELPER_VERSION)
        result.setdefault("helper_build", HELPER_BUILD)
    stdout.write(json.dumps(result))
    stdout.write("\n")
    stdout.flush()
    status = "ok" if result.get("ok") else "fail"
    line = f"jen-kea-helper: {op or '(no op)'} {status}"
    if path:
        line += f" {path}"
    stderr.write(line + "\n")
    stderr.flush()
    return exit_code


def main(argv=None, stdin=None, stdout=None, stderr=None):
    argv = sys.argv if argv is None else argv
    stdin = sys.stdin if stdin is None else stdin
    stdout = sys.stdout if stdout is None else stdout
    stderr = sys.stderr if stderr is None else stderr

    op = argv[1] if len(argv) > 1 else ""

    raw = stdin.read(MAX_STDIN + 1)
    if len(raw) > MAX_STDIN:
        return _emit(stdout, stderr, op, {"ok": False, "error": "stdin-too-large"}, 2)

    try:
        payload = json.loads(raw) if raw.strip() else {}
    except ValueError as e:
        return _emit(stdout, stderr, op, {"ok": False, "error": "bad-json", "detail": str(e)}, 2)
    if not isinstance(payload, dict):
        return _emit(stdout, stderr, op, {"ok": False, "error": "bad-json", "detail": "stdin is not a JSON object"}, 2)

    handler = _OPS.get(op)
    if handler is None:
        return _emit(stdout, stderr, op, {"ok": False, "error": "unknown-op"}, 2)

    try:
        result, path = handler(payload)
    except Exception as e:  # noqa: BLE001 — never let a bug become a stray traceback on stdout
        result, path = {"ok": False, "error": "helper-exception", "detail": str(e)}, None

    return _emit(stdout, stderr, op, result, 0, path)


if __name__ == "__main__":
    sys.exit(main())
