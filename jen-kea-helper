_SELF_PATH = "/usr/local/sbin/jen-kea-helper"
# The optional rotation/test hook (see the module doc). A module-level constant so
# tests monkeypatch it exactly like _TLS_ROOT.
_EXTRA_SIGNERS = "/etc/jen-kea-helper/allowed_signers"
_UPDATE_SIGNATURE_IDENTITY = "release@jen"
_UPDATE_SIGNATURE_NAMESPACE = "jen-kea-helper"
_UPDATE_MAX_HELPER = 512 * 1024
_UPDATE_MAX_SIGNERS = 8 * 1024
_HELPER_VERSION_RE = re.compile(rb"^HELPER_VERSION = (\d+)$", re.M)
_HELPER_BUILD_RE = re.compile(rb"^HELPER_BUILD = (\d+)$", re.M)
# v5.66.0-beta.2 (Q104) — the candidate's own preflight/postflight probe. /usr/bin/python3
# is hardcoded on purpose, not resolved through _find_bin: it is where every target this
# ships to (Ubuntu, and the system suite's Alpine image) puts it, and it is the exact same
# path the legacy grant has always named — the one fixed interpreter path this file can
# assume exists without having found it some other way first.
_PREFLIGHT_PYTHON = "/usr/bin/python3"

# v5.26.0's permanent trust root, copied here verbatim — see jen-update-root.py's own
# RELEASE_SIGNERS for the full rotation note. tests/test_kea_helper.py diffs the two
# byte for byte so they can never silently drift.
RELEASE_SIGNERS = "release@jen ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFXk5NbQwUy85pHCzLfOwPisL0JGLCOrHuRjRZSf25vD"


def _extra_signers_owner_ok(path):
    """True iff `path` is a REGULAR file, owned root:root, with no group/other write bit —
    a separate function (rather than inline in `_extra_signers_text`) so a test, which can't
    chown a real file to root without being root itself, can monkeypatch this one check
    directly instead of faking filesystem ownership."""
    try:
        st = os.lstat(path)
    except OSError:
        return False
    if not stat.S_ISREG(st.st_mode):
        return False
    return st.st_uid == 0 and st.st_gid == 0 and not (st.st_mode & 0o022)


def _extra_signers_text():
    """The optional local addition to RELEASE_SIGNERS — a rotation hook (list the new key
    here for one release before switching which key release.yml signs with) and a test
    double (a throwaway key, for the system suite). Returns "" for anything short of a
    small, root-owned, non-writable-by-others regular file: this file existing at all is
    already unusual, and failing closed on a suspicious one is safer than raising."""
    if not _extra_signers_owner_ok(_EXTRA_SIGNERS):
        return ""
    try:
        with open(_EXTRA_SIGNERS, "rb") as f:
            data = f.read(_UPDATE_MAX_SIGNERS + 1)
    except OSError:
        return ""
    if len(data) > _UPDATE_MAX_SIGNERS:
        return ""
    return data.decode("utf-8", "replace")


def _probe_helper_version(path):
    """Run `<path> version` in a throwaway process — the fixed _PREFLIGHT_PYTHON
    interpreter, isolated mode, an empty JSON object on stdin, the fixed _CLEAN_ENV, a 10 s
    timeout — and require exit 0 plus a JSON `{"ok": true, "helper_version": N,
    "helper_build": N}` reply. Used both to preflight a signed candidate BEFORE it replaces
    the live helper, and to postflight the installed path right after. Returns
    (ok, helper_version_or_None, helper_build_or_None, reason) — `reason` is a single line,
    ssh-keygen-style (the first stderr line, or a description of what went wrong), capped at
    200 chars, populated only when ok is False."""
    try:
        proc = subprocess.run(  # nosec B603
            [_PREFLIGHT_PYTHON, "-I", path, "version"],
            input=b"{}",
            capture_output=True,
            timeout=10,
            env=_CLEAN_ENV,
        )
    except (OSError, subprocess.TimeoutExpired) as e:
        return False, None, None, f"{type(e).__name__}: {e}"[:200]
    if proc.returncode != 0:
        first_err = (proc.stderr or b"").decode("utf-8", "replace").splitlines()
        reason = first_err[0] if first_err else f"exited {proc.returncode}"
        return False, None, None, reason[:200]
    try:
        reply = json.loads((proc.stdout or b"").decode("utf-8", "replace"))
    except ValueError:
        return False, None, None, "candidate's version op did not print valid JSON"
    if not isinstance(reply, dict) or reply.get("ok") is not True:
        return False, None, None, "candidate's version op did not answer ok"
    return True, reply.get("helper_version"), reply.get("helper_build"), ""


def op_update(payload):
    helper_b64 = payload.get("helper_b64")
    signature_b64 = payload.get("signature_b64")
    if not isinstance(helper_b64, str) or not isinstance(signature_b64, str):
        return {"ok": False, "error": "not-allowed"}, None
    try:
        candidate = base64.b64decode(helper_b64, validate=True)
        signature = base64.b64decode(signature_b64, validate=True)
    except (binascii.Error, ValueError):
        return {"ok": False, "error": "not-allowed"}, None
    if not candidate or len(candidate) > _UPDATE_MAX_HELPER or len(signature) > _UPDATE_MAX_SIGNERS:
        return {"ok": False, "error": "not-allowed"}, None

    keygen = _find_bin("ssh-keygen")
    if keygen is None:
        return {"ok": False, "error": "no-ssh-keygen"}, None

    tmp_dir = tempfile.mkdtemp(dir=os.path.dirname(_SELF_PATH))
    try:
        sig_path = os.path.join(tmp_dir, "candidate.sig")
        signers_path = os.path.join(tmp_dir, "allowed_signers")
        with open(sig_path, "wb") as f:
            f.write(signature)
        signers_text = RELEASE_SIGNERS.rstrip("\n") + "\n"
        extra = _extra_signers_text()
        if extra:
            signers_text += extra.rstrip("\n") + "\n"
        with open(signers_path, "w") as f:
            f.write(signers_text)

        try:
            proc = subprocess.run(  # nosec B603
                [
                    keygen,
                    "-Y",
                    "verify",
                    "-f",
                    signers_path,
                    "-I",
                    _UPDATE_SIGNATURE_IDENTITY,
                    "-n",
                    _UPDATE_SIGNATURE_NAMESPACE,
                    "-s",
                    sig_path,
                ],
                input=candidate,
                capture_output=True,
                timeout=10,
                env=_CLEAN_ENV,
            )
        except (OSError, subprocess.TimeoutExpired):
            return {"ok": False, "error": "bad-signature"}, None
        if proc.returncode != 0:
            return {"ok": False, "error": "bad-signature"}, None

        vm = _HELPER_VERSION_RE.search(candidate)
        bm = _HELPER_BUILD_RE.search(candidate)
        if not vm or not bm:
            return {"ok": False, "error": "unparseable"}, None
        new_version = int(vm.group(1))
        new_build = int(bm.group(1))
        # v5.66.0-beta.7 (Q109) — two INDEPENDENT checks, both run unconditionally. The old
        # code nested the build check inside "new_version == HELPER_VERSION", so a candidate
        # declaring a HIGHER version skipped the build check entirely and let a lower build
        # through on a protocol bump. HELPER_BUILD orders every file change regardless of
        # HELPER_VERSION — a protocol bump does not reset it — so it is checked here on its
        # own, every time, exactly like the protocol-downgrade check next to it.
        if new_version < HELPER_VERSION:
            return {"ok": False, "error": "not-newer", "detail": "protocol-downgrade"}, None
        if new_build <= HELPER_BUILD:
            return {"ok": False, "error": "not-newer", "detail": "build-not-newer"}, None

        if os.path.islink(_SELF_PATH):
            return {"ok": False, "error": "symlink"}, None
        if not os.path.isfile(_SELF_PATH):
            # update() replaces an installed helper, it never installs one — refuse before
            # any candidate bytes are written or preflighted (v5.66.0-beta.4, Q106).
            return {"ok": False, "error": "not-installed"}, None

        final_tmp = os.path.join(tmp_dir, "final")
        with open(final_tmp, "wb") as f:
            f.write(candidate)
            f.flush()
            os.fsync(f.fileno())

        # ── preflight: the candidate must run and self-report exactly what it declared ──
        pre_ok, pre_version, pre_build, pre_reason = _probe_helper_version(final_tmp)
        if not pre_ok or pre_version != new_version or pre_build != new_build:
            detail = pre_reason or "the candidate's own version op disagreed with what it declared"
            return {"ok": False, "error": "preflight-failed", "detail": detail}, None

        prev_path = _SELF_PATH + ".prev"
        if os.path.islink(prev_path):
            return {"ok": False, "error": "symlink", "path": prev_path}, None
        # _SELF_PATH is guaranteed a plain regular file at this point (checked above), so the
        # rollback copy is now unconditional — there is no longer a "nothing to roll back to"
        # case (v5.66.0-beta.4, Q106).
        shutil.copy2(_SELF_PATH, prev_path)
        os.chown(prev_path, 0, 0)  # build 14: never swallowed (this was `_chown`, which ignored a failure and carried on)
        os.chmod(prev_path, 0o755)

        os.chown(final_tmp, 0, 0)
        os.chmod(final_tmp, 0o755)
        os.replace(final_tmp, _SELF_PATH)
        fsync_error = None
        try:
            _fsync_dir(os.path.dirname(_SELF_PATH))
        except OSError as e:
            fsync_error = e  # the rename may not be durable: that is a failed install, rolled back below, never a silent skip

        # ── postflight: the INSTALLED path must answer the same way, or roll back ──
        post_ok, post_version, post_build, post_reason = _probe_helper_version(_SELF_PATH)
        if fsync_error is not None or not post_ok or post_version != new_version or post_build != new_build:
            detail = (
                f"the directory could not be synced after the install: {fsync_error}"
                if fsync_error is not None
                else post_reason or "the installed candidate's own version op disagreed after install"
            )
            try:
                os.replace(prev_path, _SELF_PATH)
            except OSError as e:
                # The rollback itself failed — _SELF_PATH may still hold the broken candidate
                # and the old bytes are stranded at prev_path. Never call this postflight-failed
                # (which implies the previous helper is back); name both paths so an
                # administrator knows exactly what to check by hand (v5.66.0-beta.4, Q106).
                return {
                    "ok": False,
                    "error": "rollback-failed",
                    "detail": f"{detail}; restoring the previous helper also failed: {e}",
                    "path": _SELF_PATH,
                    "prev_path": prev_path,
                }, None
            return {"ok": False, "error": "postflight-failed", "detail": detail}, None

        try:
            os.unlink(prev_path)
        except OSError:
            pass

        return {
            "ok": True,
            "installed_version": new_version,
            "installed_build": new_build,
            "previous_version": HELPER_VERSION,
            "previous_build": HELPER_BUILD,
        }, None
    finally:
        shutil.rmtree(tmp_dir, ignore_errors=True)


