# Jen — Docker configuration
# ─────────────────────────────────────────────────────────────────────────────
# `sudo ./install.sh --docker` writes this file for you. To do it by hand:
#   cp .env.example .env    &&    edit    &&    docker compose up -d
#
# run.py turns the JEN_* vars below into /etc/jen/jen.config the first time
# the container starts. (Prefer a hand-written jen.config? Uncomment the
# mount in the compose file and ignore the JEN_* vars.)
# ─────────────────────────────────────────────────────────────────────────────

# ── Kea Control Agent API (required) ─────────────────────────────────────────
JEN_KEA_API_URL=http://YOUR-KEA-SERVER:8000
JEN_KEA_API_USER=kea-api
JEN_KEA_API_PASS=your-kea-api-password
JEN_KEA_NAME=Kea Server 1
JEN_KEA_ROLE=primary
# HA mode: hot-standby | load-balancing | passive-backup | (leave blank)
JEN_HA_MODE=

# ── Kea MySQL database (required) ────────────────────────────────────────────
JEN_KEA_DB_HOST=YOUR-KEA-SERVER
JEN_KEA_DB_USER=kea
JEN_KEA_DB_PASS=your-kea-db-password
JEN_KEA_DB_NAME=kea

# ── Jen's own database ──────────────────────────────────────────────────────
# docker-compose.yml (external):  set all four to point at your DB server.
# docker-compose.mysql.yml (bundled): LEAVE THESE BLANK — the compose file
#   wires the jen container to the jen-mysql container itself. Only set
#   MYSQL_ROOT_PASSWORD and JEN_MYSQL_PASSWORD near the bottom.
JEN_DB_HOST=YOUR-DB-SERVER
JEN_DB_USER=jen
JEN_DB_PASS=your-jen-db-password
JEN_DB_NAME=jen

# ── First-run admin account ────────────────────────────────────────────────
# Seeds the 'admin' superadmin on the very first start, then is never read
# again. Leave blank to get the legacy admin/admin (Jen will then force a
# password change on first login).
JEN_INITIAL_ADMIN_PASSWORD=

# ── Server ports ────────────────────────────────────────────────────────────
JEN_HTTP_PORT=5050
JEN_HTTPS_PORT=8443
# Host-side port mapping (host:container) used by the compose file.
HTTP_PORT=5050
HTTPS_PORT=8443

# ── SSH to the Kea server (optional — enables subnet editing from the UI) ────
JEN_KEA_SSH_HOST=
JEN_KEA_SSH_USER=
JEN_KEA_CONF=/etc/kea/kea-dhcp4.conf

# ── DDNS integration (optional) ─────────────────────────────────────────────
# Provider: technitium | pihole | adguard | ssh | none
JEN_DDNS_PROVIDER=none
JEN_DDNS_URL=
JEN_DDNS_TOKEN=
JEN_DDNS_ZONE=
JEN_DDNS_LOG=/var/log/kea/kea-ddns.log

# ── Subnet map (optional) ──────────────────────────────────────────────────
# Format: id=Name,CIDR  — semicolon-separated.
# Example: JEN_SUBNETS=1=Production,10.10.10.0/24;30=IoT,10.10.30.0/24
JEN_SUBNETS=

# ── Bundled MariaDB — docker-compose.mysql.yml ONLY ─────────────────────────
# Required for the bundled path; compose refuses to start if left blank
# (no silent fallback to a known password — fixed v4.4.8).
# JEN_MYSQL_PASSWORD is used on BOTH sides (the jen-mysql container and the
# jen container's JEN_DB_PASS).
MYSQL_ROOT_PASSWORD=
JEN_MYSQL_PASSWORD=
